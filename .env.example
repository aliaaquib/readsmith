# Anthropic API key — required for project understanding + README generation.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Model used for the generation pipeline. Optional — sensible default applied.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# GitHub personal access token — OPTIONAL.
# Without it, public repos still work (subject to lower rate limits).
# With it, you get higher rate limits and can read private repositories.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=
